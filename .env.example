# Copy this to .env for local runs, and add SUPABASE_URL + SUPABASE_SECRET_KEY in Vercel Environment Variables.
# NEVER commit your real .env or SUPABASE_SECRET_KEY to GitHub!
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Optional Vendor & Demo Vendor Authentication overrides
VENDOR_USERNAME=vendor
VENDOR_PASSWORD=bbs@2026
DEMO_VENDOR_USERNAME=demovendor
DEMO_VENDOR_PASSWORD=demo@1234
VENDOR_AUTH_SECRET=change-me-to-a-random-secret
